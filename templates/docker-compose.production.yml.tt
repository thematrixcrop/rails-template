# Production layout: one image, three roles. `migrate` prepares all four
# databases once, then `web` (Puma behind Thruster) and `queue` (Solid Queue)
# start.
#
#   APP_IMAGE=ghcr.io/<owner>/<%= app_name %>:<tag> docker compose -f docker-compose.production.yml up -d
x-app-env: &app-env
  RAILS_ENV: production
  RAILS_LOG_LEVEL: ${RAILS_LOG_LEVEL:-info}
  RAILS_MASTER_KEY: ${RAILS_MASTER_KEY:?set RAILS_MASTER_KEY}
  APP_HOST: ${APP_HOST:?set APP_HOST}
  DB_HOST: ${DB_HOST:?set DB_HOST}
  DB_PORT: ${DB_PORT:-3306}
  DB_USER: ${DB_USER:?set DB_USER}
  DB_PASSWORD: ${DB_PASSWORD:?set DB_PASSWORD}
  PRIMARY_DB_NAME: ${PRIMARY_DB_NAME:-<%= app_name %>_primary_production}
  CACHE_DB_NAME: ${CACHE_DB_NAME:-<%= app_name %>_cache_production}
  QUEUE_DB_NAME: ${QUEUE_DB_NAME:-<%= app_name %>_queue_production}
  CABLE_DB_NAME: ${CABLE_DB_NAME:-<%= app_name %>_cable_production}

x-app: &app
  image: ${APP_IMAGE:?set APP_IMAGE}
  environment: *app-env
  restart: unless-stopped

services:
  migrate:
    <<: *app
    command: ["./bin/rails", "db:prepare"]
    restart: "no"

  web:
    <<: *app
    command: ["./bin/thrust", "./bin/rails", "server"]
    environment:
      <<: *app-env
      SOLID_QUEUE_IN_PUMA: "false"
    ports:
      - "${WEB_PORT:-3000}:80"
    depends_on:
      migrate:
        condition: service_completed_successfully
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://localhost/up"]
      interval: 15s
      timeout: 5s
      retries: 5

  queue:
    <<: *app
    command: ["./bin/jobs"]
    depends_on:
      migrate:
        condition: service_completed_successfully
