# Local, environment-specific settings. Copy to `.env` (`bin/setup` does this).
# `.env` and `.env.local` are gitignored. dotenv loads them in development and
# test only. Production reads real process ENV (CapRover, systemd, the host).
#
# Put values that change per machine or per environment here:
# database, APP_HOST, log level, local HTTP basic users.
#
# Put values that are the same in every environment in Rails credentials:
#   bin/rails credentials:edit
# See config/credentials.example.yml for the layout.

# --- Database ---------------------------------------------------------------
# Defaults: root/root over /tmp/mysql.sock. Set DB_HOST to use TCP instead.
# DB_USER=root
# DB_PASSWORD=root
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_SOCKET=/tmp/mysql.sock
# Production database names:
# PRIMARY_DB_NAME=app_primary_production
# CACHE_DB_NAME=app_cache_production
# QUEUE_DB_NAME=app_queue_production
# CABLE_DB_NAME=app_cable_production

# --- Public URL -------------------------------------------------------------
APP_HOST=localhost:3000
# APP_PROTOCOL=http

# --- Mission Control Jobs (/jobs) ------------------------------------------
# Override credentials for this machine. Leave unset to use credentials.
# MISSION_CONTROL_USER=admin
# MISSION_CONTROL_PASSWORD=admin

# --- Runtime ----------------------------------------------------------------
# RAILS_LOG_LEVEL=info
# RAILS_MAX_THREADS=3
# JOB_CONCURRENCY=1
# SOLID_QUEUE_IN_PUMA=true
